{
  "name": "stickyard",
  "version": "0.39.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "worker"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p dev/load",
    "test": "npm run test --workspaces && vitest run --config dev/load/vitest.unit.config.ts",
    "build": "npm run build -w web -w worker",
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "shots": "node scripts/shots.mjs",
    "load": "vitest run --config dev/load/vitest.load.config.ts",
    "a11y": "node dev/a11y/audit.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "playwright-core": "^1.56.1",
    "typescript": "5.9",
    "vitest": "^4.1.11"
  }
}
