{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stickyard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      // One instance (fixed name) holding the room-creation abuse counters.
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  "vars": {
    // The only configured browser origin allowed to open /ws (scheme + host, no path).
    // Comma-separated if more are ever needed. localhost/127.0.0.1 on any port are always allowed for dev.
    "ALLOWED_ORIGINS": "https://kishore510.github.io"
  }
  // Secrets, never in this file: CREATE_PASSCODE and ROOM_SIGNING_KEY (pushed from GitHub
  // secrets by the deploy job), and CREATION_ENABLED (the kill switch, set by the
  // "Room creation switch" workflow). Local dev reads them from .dev.vars.
}
